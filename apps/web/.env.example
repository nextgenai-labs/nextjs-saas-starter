# ─── Database ───────────────────────────────────────────────
# Required. PostgreSQL connection string.
DATABASE_URL="postgres://user:password@localhost:5432/saas-starter"
# Optional read replica for production deployments
DATABASE_URL_READ_REPLICA=""

# ─── NextAuth (Required) ───────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The canonical URL of your app (no trailing slash)
AUTH_URL="http://localhost:3000"

# ─── OAuth Providers ───────────────────────────────────────
# GitHub OAuth App: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth App: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Email (Resend) ───────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"

# ─── App Config ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="0.0.0"

# ─── Logging ───────────────────────────────────────────────
# Levels: debug, info, warn, error
LOG_LEVEL="info"

# ─── Environment ───────────────────────────────────────────
# Set to "production" for production deployments
NODE_ENV="development"

# ─── Redis (Optional) ─────────────────────────────────────
# For session caching and rate limiting in production
REDIS_URL=""
